# API Configuration
# Primary API (used for dragon_eyes)
API_KEY_PRIMARY=your_api_key_here
API_URL_PRIMARY=https://api.openai.com/v1
API_MODEL_PRIMARY=qwen3.5-flash

# Secondary API (used for dragon_speaking, memory_conclude, memory_compress)
API_KEY_SECONDARY=your_api_key_here
API_URL_SECONDARY=https://api.openai.com/v1
API_MODEL_SECONDARY=qwen-plus-character

# Deepseek API (optional, if used separately)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com

# Bot Configuration
BOT_USERNAME=your_bot_username
BOT_ACCESS_TOKEN=your_access_token
ROOM_NAME=your_room_name

# Server Configuration (optional, defaults are provided in config.py)
# HTTP_BASE=https://room.caffeine.ink
# LOGIN_URL=https://room.caffeine.ink/api/login
